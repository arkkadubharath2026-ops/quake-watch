# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
QW_ENV=development                 # development | test | production
QW_SECRET_KEY=change-me-to-a-long-random-string
QW_DEBUG=true
QW_ALLOWED_HOSTS=localhost,127.0.0.1
QW_CSRF_TRUSTED_ORIGINS=http://localhost:8000
QW_NUM_PROXIES=0                   # set to 1 behind one reverse proxy (client IP from X-Forwarded-For)

# ArangoDB (primary database for all domain data)
QW_ARANGO_URL=http://127.0.0.1:8529
QW_ARANGO_DB=quakewatch
QW_ARANGO_USER=root
QW_ARANGO_PASSWORD=change-me
QW_ARANGO_ROOT_PASSWORD=change-me  # used by docker-compose to initialise the server



# Ingestion
QW_USGS_BASE_URL=https://earthquake.usgs.gov
QW_SYNC_FEED=all_day               # USGS summary feed used by the scheduled sync
QW_SYNC_INTERVAL_SECONDS=300
QW_HTTP_CONNECT_TIMEOUT=5
QW_HTTP_READ_TIMEOUT=20
QW_HTTP_MAX_RETRIES=4
QW_FRESHNESS_DEGRADED_MINUTES=20   # source considered degraded if no successful sync within this window
QW_FRESHNESS_STALE_MINUTES=120

# Observability
QW_LOG_LEVEL=INFO
QW_LOG_JSON=false                  # true in production for machine-readable logs
